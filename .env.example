# Banco (usado pelo docker compose)
POSTGRES_DB=skycef
POSTGRES_USER=skycef
POSTGRES_PASSWORD=skycef

# API (formato SQLAlchemy + psycopg 3)
DB_URL=postgresql+psycopg://skycef:skycef@localhost:5432/skycef
CORS_ORIGINS=http://localhost:5173
# Aplica as migrations ao iniciar a API
MIGRAR_AO_INICIAR=true

# Consulta em linguagem natural (diferencial)
ANTHROPIC_API_KEY=
