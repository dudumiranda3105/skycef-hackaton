# IA do Pergunte aos Dados (opcional; preencha com uma chave Gemini recém-gerada).
# Nunca versione o arquivo .env real.
GEMINI_API_KEY=

# Banco (usado pelo docker compose)
POSTGRES_DB=skycef
POSTGRES_USER=skycef
POSTGRES_PASSWORD=skycef

# API Spring Boot (PostgreSQL via JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/skycef
SPRING_DATASOURCE_USERNAME=skycef
SPRING_DATASOURCE_PASSWORD=skycef
CORS_ORIGINS=http://localhost:5173

# Login: senha dos usuários iniciais (admin, diretoria, compras, armazem, encarregado, fornecedor),
# criados só na primeira subida. Valor de demonstração: troque em "Alterar senha" ou defina outro aqui.
# Vazio = a API gera uma senha aleatória e a mostra uma única vez no log.
SENHA_INICIAL=cocapec2026
# false desliga o login (só para desenvolvimento)
AUTH_ATIVA=true
